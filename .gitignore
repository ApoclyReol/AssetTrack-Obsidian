*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Obsidian plugin dependencies, build output, caches, and coverage
node_modules/
dist/
.vite/
.cache/
coverage/
.eslintcache
*.tsbuildinfo

# Packaged build output
build/
*.dmg
*.pkg
